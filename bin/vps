#!/usr/bin/env bash
# Runs a command on the practice machine near the server, where a request takes about 10 ms instead of 80.
#
#   export SPREAD_TRACK=t1
#   bin/vps python3 -m harness.run --policy t1 --seeds dev
#   bin/vps python3 tracks/t2/fork_test.py
#
# It copies this checkout to the machine, runs the command there (detached: a dropped connection does not stop it),
# then copies the results back:
# the shared data folder (data/runs, data/runs.jsonl) and whatever the command wrote under tracks/.
# The slot locks live on that machine, so every command that plays weeks must go through here.
# Commands that only read saved weeks run locally, as before.
set -euo pipefail

home="${SPREAD_HOME:-/home/agent/.t3/projects/bahn}"
vps="$(grep -E '^SPREAD_VPS=' "$home/.env" | cut -d= -f2-)"
key="$(grep -E '^SPREAD_VPS_KEY=' "$home/.env" | cut -d= -f2-)"
: "${vps:?SPREAD_VPS is not set in $home/.env}"
: "${SPREAD_TRACK:?Set SPREAD_TRACK to your track}"
[ "$#" -gt 0 ] || { echo "usage: bin/vps <command...>" >&2; exit 2; }

root="$(git rev-parse --show-toplevel)"
name="$(basename "$root")"
version="$(cd "$root" && python3 -c 'from harness import config; print(config.git_version())')"
# One connection for each command: a shared connection carries at most 10 sessions, and four tracks need more.
ssh=(ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes -o ControlMaster=no -o ControlPath=none -o ServerAliveInterval=15 -o LogLevel=ERROR)

rsync -az --delete --exclude .git --exclude data --exclude __pycache__ --exclude .direnv --exclude result --exclude .env \
  -e "${ssh[*]}" "$root/" "$vps:bahn/trees/$name/"

# The command runs detached on the machine and writes to a log there. This side follows the log. When the
# connection drops, the command goes on; this side reconnects and prints what it missed. When this side
# is stopped (Ctrl-C, kill), it stops the command too, so its worlds are freed.
log="bahn/data/logs/vps-$name-$(date +%s)-$$.log"
"${ssh[@]}" "$vps" "mkdir -p bahn/data/logs && cd bahn/trees/$name && (setsid nohup env SPREAD_HOME=\$HOME/bahn SPREAD_ON_VPS=1 SPREAD_TRACK=$SPREAD_TRACK SPREAD_VERSION=$version PYTHONUNBUFFERED=1 \
  bash -c $(printf '%q' "$(printf '%q ' "$@"); echo \"__exit \$?\"") > \$HOME/$log 2>&1 < /dev/null & echo \$! > \$HOME/$log.pid)"
trap '"${ssh[@]}" "$vps" "kill -- -\$(cat \$HOME/$log.pid) 2>/dev/null" || true; exit 130' INT TERM
seen=0
state="$(mktemp)"
while true; do
  echo "0 255" > "$state"
  "${ssh[@]}" -o ServerAliveCountMax=4 "$vps" "tail --pid=\$(cat \$HOME/$log.pid) -n +$((seen + 1)) -f \$HOME/$log" < /dev/null \
    | awk -v state="$state" '/^__exit [0-9]+$/ { code = $2; next } { print; fflush(); n++ } END { print n + 0, (code == "" ? 255 : code) > state }' || true
  read -r got status < "$state"
  seen=$((seen + got))
  [ "$status" != 255 ] && break
  # No exit line yet: the connection broke, or the log ended without one. Look again when the machine answers.
  if "${ssh[@]}" "$vps" "! kill -0 \$(cat \$HOME/$log.pid) 2>/dev/null && ! grep -q '^__exit' \$HOME/$log" 2>/dev/null; then status=1; break; fi
  sleep 5
done
rm -f "$state"
trap - INT TERM

mkdir -p "$home/data"
# Weeks are written on the practice machine only, and this copy never goes back up. --update keeps a newer local file.
rsync -azu -e "${ssh[*]}" "$vps:bahn/data/runs" "$home/data/" 2>/dev/null || true
copy="$(mktemp)"
if rsync -az -e "${ssh[*]}" "$vps:bahn/data/runs.jsonl" "$copy" 2>/dev/null; then
  (cd "$root" && SPREAD_HOME="$home" python3 -m harness.merge_index "$copy" > /dev/null) || true
fi
rm -f "$copy"
rsync -azu -e "${ssh[*]}" "$vps:bahn/trees/$name/tracks/" "$root/tracks/" 2>/dev/null || true
exit "$status"
